# Server-only. Never commit real values. Never expose to the browser.
# Obtain a hackathon key via the official form, then configure interactively:
#   qloo setup --qloo
# Or paste into .env.local (gitignored).

QLOO_API_KEY=your_hackathon_api_key_here
QLOO_API_BASE_URL=https://hackathon.api.qloo.com

# UI-only development. When true, discovery uses labeled sample affinities
# and must never be presented as a successful live Qloo response.
SAMPLE_DATA_MODE=false
